# ── Manhwa Studio environment configuration (placeholders only) ─────────────
#
# The Worker reads the server-side variables below (auth, D1 binding, Gemini).
# The frontend reads only VITE_API_BASE_URL at BUILD time; vite.config.ts also
# reads DISABLE_HMR. Everything else is server-only or documentation for later
# tasks. Never expose a secret through a VITE_ variable.
#
# RULES:
#   - Real values go in the platform secret manager, or in an untracked
#     .env.local / .dev.vars (both gitignored). NEVER commit real values.
#   - NEVER prefix a secret with VITE_ — Vite inlines VITE_* variables into
#     the browser bundle. Client-exposed config must be non-secret only.
#   - Verify secrets by presence only (configured / missing); never print values.
#   - Do not paste secrets into chat, issues, logs, screenshots, or telemetry.

# ── Build/dev (used today) ──────────────────────────────────────────────────
# Set to "true" to disable Vite HMR/file watching (AI Studio convention).
DISABLE_HMR="false"

# Public API origin for the frontend. Empty/unset means same-origin, which is
# how the Worker-hosted build runs. A separately hosted frontend (Vercel) MUST
# set this, at BUILD time, to the API origin — Vite inlines it into the bundle,
# so changing it requires a new deployment. Bare origin only (scheme + host,
# optional port); a path or credentials are rejected by src/lib/apiConfig.ts.
# Public configuration, never a secret — do not put credentials here.
VITE_API_BASE_URL=""
#
# Vercel project settings (see docs/DEPLOYMENT-VERCEL.md):
#   Root Directory     repository root
#   Framework Preset   Vite
#   Install Command    bun install --frozen-lockfile
#   Build Command      bun run build
#   Output Directory   dist
#   Node/package mgr   Bun is auto-detected from the committed bun.lock
# and one Environment Variable for Production + Preview:
#   VITE_API_BASE_URL = https://<the-API-origin>   (public)
# The same Vercel origin must then be added to the Worker's ALLOWED_ORIGINS
# below, or the browser gets no CORS headers and every call fails.

# ── Cloudflare (TASK 06: Worker/API foundation; CLI/deploy usage) ───────────
# Server-side API token for the deploy pipeline / wrangler CLI.
# Scope it least-privilege (e.g. Workers Scripts:Edit, D1:Edit, R2:Edit).
# Not read by the frontend, ever.
CLOUDFLARE_API_TOKEN="REPLACE_ME"
CLOUDFLARE_ACCOUNT_ID="REPLACE_ME"
# D1 databases and R2 buckets are configured as Worker *bindings* in wrangler
# configuration (env.DB / env.FILES), not as environment values in this file.

# ── Freebuff identity / OIDC (TASK 07: authentication) ──────────────────────
# Reserved public variables injected on deploy; local values are placeholders.
FREEBUFF_CLIENT_ID="REPLACE_ME"
FREEBUFF_ISSUER="https://REPLACE_ME"
APP_ORIGIN="https://REPLACE_ME"
# Comma-separated EXACT origins additionally allowed to call the API
# cross-origin (the second host). `*` is rejected by design; credentialed CORS
# requires concrete origins. APP_ORIGIN is always included.
# A Vercel frontend needs its own origin(s) here, e.g. a production domain and
# the preview URL(s) actually used; a preview deployment's origin changes per
# deployment, so either pin a stable preview domain or add each origin.
# Verify with scripts/verify-deployment.mjs after setting it.
ALLOWED_ORIGINS="https://REPLACE_ME"
# Each origin above must be registered with its own callback URL:
#   https://<that-origin>/auth/freebuff/callback
# Public values only — there is no OIDC client secret. Never derive APP_ORIGIN
# from a request Host header.

# ── Supabase (OPTIONAL — only for a single approved, documented role) ───────
# Default architecture is Cloudflare D1 + R2; Supabase must not become a
# second authoritative database. The connection string contains a database
# password: secret manager / untracked file only.
SUPABASE_URL="https://REPLACE_ME.supabase.co"
SUPABASE_DB_URL="postgresql://REPLACE_ME"
# Server-side PostgREST key for the SECONDARY backup target only (never read by
# the frontend, never logged). Backup reports `not_configured` while absent.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"

# ── AI provider (TASK 04: server-side story generation) ────────────────────
# Both variables are required. Generation returns `provider_not_configured`
# and charges nothing unless both are present. GEMINI_MODEL is an explicit
# model id (no default is invented), e.g. a currently available Gemini model
# from Google's documentation. Do not paste real values into chat or commit
# them; use the platform secret store or an untracked .dev.vars.
# FREE_ONLY policy: never a silent fallback to a paid provider.
GEMINI_API_KEY="REPLACE_ME"
GEMINI_MODEL="REPLACE_ME"

# ── YouTube OAuth (TASK 16, later phase) ────────────────────────────────────
YOUTUBE_OAUTH_CLIENT_ID="REPLACE_ME"
YOUTUBE_OAUTH_CLIENT_SECRET="REPLACE_ME"
